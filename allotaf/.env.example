# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.

# URL publique du site (utilisée pour le SEO, le sitemap et les images de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notifications e-mail (facultatif) -------------------------------------
# Sans ces variables, les demandes sont seulement enregistrées (mode démo : .data/leads.json).
RESEND_API_KEY=
NOTIFY_EMAIL=
# Expéditeur vérifié chez Resend. Par défaut : onboarding@resend.dev (tests uniquement).
RESEND_FROM=

# --- Supabase (phase 3) -----------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
